# Copiar a .env y ajustar. NUNCA commitear el .env real.
#   cp .env.example .env

# ---------- API ----------
SERVER_PORT=8080
LOG_LEVEL_APP=INFO
SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- PostgreSQL ----------
DB_NAME=medirecord
DB_USER=medirecord
DB_PASSWORD=medirecord
DB_PORT=5432
DB_HOST=localhost
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ---------- Keycloak ----------
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# Issuer que usa la API para validar los JWT.
# Desde el host: http://localhost:8081/realms/medirecord
# Dentro de docker compose: http://keycloak:8080/realms/medirecord
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/medirecord
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/medirecord/protocol/openid-connect/certs

# Credenciales del cliente confidencial de desarrollo (definido en docker/keycloak/medirecord-realm.json)
KEYCLOAK_CLIENT_ID=medirecord-api
KEYCLOAK_CLIENT_SECRET=medirecord-secret

# Usuarios de prueba del realm
DEV_USER_ADMIN=admin
DEV_USER_ADMIN_PASSWORD=admin123