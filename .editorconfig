# EditorConfig: IntelliJ/Eclipse/VS Code respeta estas reglas.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{java,kt}]
indent_style = tab
indent_size = 4
max_line_length = 120

[*.{xml,yml,yaml,properties,json,sql,html,css,js,ts,tsx}]
indent_style = space
indent_size = 2

[*.properties]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf